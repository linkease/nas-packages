config ddnsto
	# Optional self-update test overrides. Leave empty for the official fw source.
	option update_base_url ''
	option update_github_repo ''
	option update_github_branch 'main'
	# Keep LuCI update controls disabled by default; set to 1 to restore them.
	option update_enabled '0'
	option enabled '0'
	# option token ''
	option index '0'
	option logger '0'
	option feat_enabled '0'
	option feat_port '3033'
	# option feat_username ''
	# option feat_password ''
	# option feat_disk_path_selected ''
	# option address ''
